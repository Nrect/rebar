# Окружение стенда из compose.yaml: Postgres и Mailpit на localhost.
#
# ПОСЛАБЛЕНИЯ ЗДЕСЬ ЯВНЫЕ И ТОЛЬКО ДЛЯ СТЕНДА: http без Secure у куки, Mailpit
# без TLS и пароля. Код их по умолчанию не даёт — забытая переменная
# предохранитель не снимает (docs/CONSUMER.md, §2). AUTH_SECRET сюда не кладут:
# он задаётся при запуске (README). Этим же файлом поднимаются тесты стенда.
ENVIRONMENT=development
LOG_LEVEL=debug
DATABASE_URL=postgres://monolith:monolith@localhost:5432/monolith?sslmode=disable
BASE_URL=http://localhost:8080
SESSION_COOKIE_SECURE=false
MAIL_FROM=shop@example.test
MAIL_DOMAIN=example.test
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_TLS=none
SMTP_AUTH=none
SMTP_ALLOW_PLAINTEXT=true
