# Исключения стража времени (scripts/timeguard.sh): путь<TAB>строка кода<TAB>причина.
# Починил — вычеркни: запись, которой нет в коде, роняет стража.
outbox/outboxotel/handlers.go	start := time.Now()	длительность хендлера по монотонным часам (time.Since), момент не хранится
auth/session/service.go	return &Service{cfg: cfg, deps: deps, now: time.Now}	часы по умолчанию без UTC; модуль в заморозке 7c1a927 — волна часов в UTC после тегов (ROADMAP)
mail/cmd/sesfake/relay.go	now:    time.Now,	часы по умолчанию без UTC; письмо собирается из now().UTC(); модуль в заморозке — волна после тегов (ROADMAP)
mail/sesv2/sesv2.go	now:              time.Now,	часы по умолчанию без UTC; подпись SigV4 сама приводит к UTC; модуль в заморозке — волна после тегов (ROADMAP)
kit/ratelimit/limiter.go	now:      time.Now,	часы по умолчанию без UTC; лимитер считает только длительности; модуль в заморозке — волна после тегов (ROADMAP)
