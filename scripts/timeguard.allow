scheduler/schedulertest/recording.go	if time.Now().After(deadline) {	срок ожидания в помощнике теста, момент не хранится
postgres/pgtest/pgtest.go	sweep(ctx, admin, time.Now())	имя и возраст тестовых баз стенда, не данные
postgres/pgtest/pgtest.go	name, err := newDBName(time.Now())	имя и возраст тестовых баз стенда, не данные
